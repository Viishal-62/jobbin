generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
   
}

 

model Job {
  id          String   @id @default(cuid())

  ats         String
  company     String
  logo        String?
  title       String
  location    String?
  description String?
  category    String?
  tags        Json?
  jobtype     String?
  salary      String?
  applyUrl    String

  hash        String   @unique

  postedAt    DateTime?
  firstSeen   DateTime
  lastSeen    DateTime
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())

  @@index([title])
  @@index([company])
  @@index([isActive])
}

